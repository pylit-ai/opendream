{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider-entry.schema.json",
  "title": "ProviderEntry",
  "type": "object",
  "required": [
    "provider_id",
    "transport",
    "model_id"
  ],
  "properties": {
    "provider_id": { "type": "string" },
    "transport": { "type": "string" },
    "model_id": { "type": "string" },
    "context_window": { "type": "integer" },
    "cost_hints": {
      "type": "object",
      "properties": {
        "input_per_token_usd": { "type": "number" },
        "output_per_token_usd": { "type": "number" }
      },
      "additionalProperties": false
    },
    "rate_limit_hints": {
      "type": "object",
      "properties": {
        "requests_per_minute": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "supports_structured_output": { "type": "boolean" },
    "supports_reasoning_effort": { "type": "boolean" },
    "supports_tool_use": { "type": "boolean" },
    "supports_local_offline_use": { "type": "boolean" },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["anticipation", "synthesis", "verification", "benchmark_judge", "harness_optimizer"]
      }
    },
    "health_status": {
      "type": "string",
      "enum": ["healthy", "degraded", "unavailable"]
    },
    "last_health_check_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
