{
  "type": "object",
  "required": [
    "version",
    "job_id",
    "title",
    "description",
    "skill_ref",
    "enabled",
    "trigger",
    "input_selectors",
    "output",
    "merge_policy",
    "decay_policy",
    "review_policy",
    "security_policy",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "job_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "skill_ref": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "trigger": {
      "type": "object",
      "required": ["type", "interval_seconds"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["interval"]
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "input_selectors": {
      "type": "object",
      "required": ["memory_types_any", "text_terms_any", "statuses_any", "limit"],
      "properties": {
        "memory_types_any": {
          "type": "array",
          "items": {"type": "string"}
        },
        "text_terms_any": {
          "type": "array",
          "items": {"type": "string"}
        },
        "statuses_any": {
          "type": "array",
          "items": {"type": "string"}
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["record_type", "max_records"],
      "properties": {
        "record_type": {
          "type": "string",
          "enum": ["feature", "bug", "fix", "research-delta", "generic"]
        },
        "max_records": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "merge_policy": {
      "type": "object",
      "required": ["dedupe_by"],
      "properties": {
        "dedupe_by": {
          "type": "string",
          "enum": ["title", "title+summary"]
        }
      },
      "additionalProperties": false
    },
    "decay_policy": {
      "type": "object",
      "required": ["stale_after_runs"],
      "properties": {
        "stale_after_runs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "review_policy": {
      "type": "object",
      "required": ["require_manual_review", "auto_surface_limit"],
      "properties": {
        "require_manual_review": {
          "type": "boolean"
        },
        "auto_surface_limit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "security_policy": {
      "type": "object",
      "required": ["allow_sensitive"],
      "properties": {
        "allow_sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
