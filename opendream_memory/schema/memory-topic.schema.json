{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-topic.schema.json",
  "title": "MemoryTopic",
  "type": "object",
  "required": [
    "memory_id",
    "type",
    "scope",
    "title",
    "summary",
    "status",
    "created_at",
    "updated_at",
    "source_event_ids"
  ],
  "properties": {
    "memory_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "semantic_fact",
        "procedural_workflow",
        "user_preference",
        "project_decision",
        "environment_requirement",
        "anti_pattern",
        "pending_item",
        "contested_fact",
        "superseded_record"
      ]
    },
    "scope": {
      "type": "string",
      "enum": ["user", "project", "agent", "workspace", "global"]
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "body": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "contested", "superseded", "deprecated", "deleted"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "salience": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_event_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflicts_with": {
      "type": "array",
      "items": { "type": "string" }
    },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": ["string", "null"], "format": "date-time" },
    "access_count": { "type": "integer", "minimum": 0 },
    "last_accessed_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
