{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consolidation-op.schema.json",
  "title": "ConsolidationOperation",
  "type": "object",
  "required": [
    "op_id",
    "run_id",
    "op",
    "target_id",
    "reason",
    "source_event_ids",
    "timestamp"
  ],
  "properties": {
    "op_id": { "type": "string" },
    "run_id": { "type": "string" },
    "op": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "supersede",
        "mark_contested",
        "quarantine",
        "delete",
        "reindex"
      ]
    },
    "target_id": { "type": "string" },
    "payload": { "type": "object" },
    "reason": { "type": "string" },
    "source_event_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
