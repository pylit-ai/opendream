{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptProbeReport",
  "type": "object",
  "required": [
    "run_id",
    "probes",
    "hits",
    "windows_read",
    "escalations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hits": {
      "type": "integer"
    },
    "windows_read": {
      "type": "integer"
    },
    "escalations": {
      "type": "integer"
    },
    "bytes_read": {
      "type": "integer"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
