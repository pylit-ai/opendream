{
  "type": "object",
  "required": [
    "report_id",
    "run_id",
    "generated_at",
    "verifier_mode",
    "commit_verdict",
    "blocked_action_ids",
    "review_action_ids",
    "findings",
    "warnings"
  ],
  "properties": {
    "report_id": {"type": "string"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "verifier_mode": {"type": "string"},
    "commit_verdict": {"type": "string", "enum": ["allow", "block"]},
    "blocked_action_ids": {"type": "array", "items": {"type": "string"}},
    "review_action_ids": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "action_id", "severity", "verdict", "message"],
        "properties": {
          "finding_id": {"type": "string"},
          "action_id": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "warning", "error"]},
          "verdict": {"type": "string", "enum": ["allow", "review", "block"]},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
