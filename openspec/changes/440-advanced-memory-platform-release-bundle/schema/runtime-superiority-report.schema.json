{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeSuperiorityReport",
  "type": "object",
  "required": [
    "report_id",
    "generated_at",
    "modes",
    "memory_excellence_summary",
    "docs_truthfulness",
    "release_verdict"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "memory_excellence_summary": {
      "type": "object"
    },
    "docs_truthfulness": {
      "type": "object"
    },
    "release_verdict": {
      "enum": [
        "pass",
        "fail",
        "partial"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
