{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-adapter-manifest.schema.json",
  "type": "object",
  "required": [
    "adapter_id",
    "kind",
    "execution_owner",
    "auth_source",
    "supports_local_files",
    "supports_background_schedule",
    "ingest_mode"
  ],
  "properties": {
    "adapter_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "codex-account",
        "claude-scheduled-task",
        "cursor-automation"
      ]
    },
    "execution_owner": {
      "enum": [
        "opendream-local",
        "vendor-runtime"
      ]
    },
    "auth_source": {
      "enum": [
        "chatgpt-account",
        "claude-account-task",
        "cursor-account-automation",
        "cursor-api-key",
        "provider-api-key"
      ]
    },
    "supports_local_files": {
      "type": "boolean"
    },
    "supports_background_schedule": {
      "type": "boolean"
    },
    "ingest_mode": {
      "enum": [
        "direct-report",
        "delegated-envelope"
      ]
    },
    "trust_boundary": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
