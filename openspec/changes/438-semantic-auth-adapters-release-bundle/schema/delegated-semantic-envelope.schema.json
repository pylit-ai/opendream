{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delegated-semantic-envelope.schema.json",
  "type": "object",
  "required": [
    "adapter_id",
    "run_id",
    "execution_owner",
    "created_at",
    "workspace_ref",
    "anticipated_query_families",
    "proposals"
  ],
  "properties": {
    "adapter_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "execution_owner": {
      "enum": [
        "claude-scheduled-task",
        "cursor-automation"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "workspace_ref": {
      "type": "string"
    },
    "base_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch_or_worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "anticipated_query_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proposed_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verification_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
