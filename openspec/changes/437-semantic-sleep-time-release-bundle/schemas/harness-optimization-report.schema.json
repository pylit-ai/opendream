{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessOptimizationReport",
  "type": "object",
  "required": [
    "run_id",
    "search_space",
    "evaluated_variants",
    "winner"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "search_space": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluated_variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "winner": {
      "type": "string"
    },
    "score_trace": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
