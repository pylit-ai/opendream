{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticDreamReport",
  "type": "object",
  "required": [
    "run_id",
    "mode",
    "phases",
    "query_families",
    "proposal_count",
    "promotion_count"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "query_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposal_count": {
      "type": "integer"
    },
    "promotion_count": {
      "type": "integer"
    },
    "rejection_count": {
      "type": "integer"
    },
    "harm_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_ms": {
      "type": "integer"
    }
  }
}
