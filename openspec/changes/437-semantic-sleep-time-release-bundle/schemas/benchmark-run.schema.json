{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkRun",
  "type": "object",
  "required": [
    "benchmark_id",
    "mode",
    "scores"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "scores": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
