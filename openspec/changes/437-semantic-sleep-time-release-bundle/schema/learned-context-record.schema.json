{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learned-context-record.schema.json",
  "title": "LearnedContextRecord",
  "type": "object",
  "required": [
    "record_id",
    "workspace_id",
    "source_event_ids",
    "summary",
    "provider_id",
    "model_id",
    "prompt_version",
    "created_at",
    "fresh_until",
    "confidence",
    "verifier_status",
    "status"
  ],
  "properties": {
    "record_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "source_event_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_episode_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_trace_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "query_family_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "details": { "type": "string" },
    "assumptions": { "type": "string" },
    "provider_id": { "type": "string" },
    "model_id": { "type": "string" },
    "prompt_version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "fresh_until": { "type": "string", "format": "date-time" },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verifier_status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "review_required"]
    },
    "conflict_state": {
      "type": "string",
      "enum": ["none", "detected", "resolved", "overridden"]
    },
    "superseded_by": {
      "type": ["string", "null"]
    },
    "harm_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "promotion_target": {
      "type": "string",
      "enum": ["none", "learned_context", "durable_record"]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "superseded", "archived", "rejected"]
    }
  },
  "additionalProperties": false
}
