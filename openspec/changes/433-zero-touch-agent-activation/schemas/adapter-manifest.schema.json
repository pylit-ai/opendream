{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opendream.local/schema/adapter-manifest.schema.json",
  "title": "OpenDream agent adapter manifest",
  "description": "Declarative adapter: detection rules + install profile (swiz/MCP-style versioned manifest).",
  "type": "object",
  "required": [
    "id",
    "version",
    "activation_mode",
    "detection",
    "install_profile",
    "install"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "Stable adapter id (kebab-case / dotted), used as target_kind and HTML block marker."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic version or opaque profile revision (e.g. 1, 1.0, 2026-03-29)."
    },
    "title": {
      "type": "string"
    },
    "activation_mode": {
      "type": "string",
      "enum": [
        "native_hooks",
        "native_project_settings",
        "managed_wrapper",
        "managed_prompt_snippet",
        "unsupported"
      ]
    },
    "detection": {
      "type": "object",
      "required": [
        "detected",
        "configured"
      ],
      "properties": {
        "detected": {
          "$ref": "#/definitions/detectionRule"
        },
        "configured": {
          "$ref": "#/definitions/detectionRule"
        }
      },
      "additionalProperties": false
    },
    "install_profile": {
      "type": "string",
      "enum": [
        "claude_code_hooks",
        "codex_bundle",
        "openclaw_hooks",
        "shell_hooks_mdc_block",
        "shell_hooks_markdown_block"
      ]
    },
    "install": {
      "type": "object",
      "description": "Profile-specific payload; validated in code per install_profile."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "detectionRule": {
      "type": "object",
      "required": [
        "any_path_exists"
      ],
      "properties": {
        "any_path_exists": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  }
}
