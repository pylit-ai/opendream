{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query-family.schema.json",
  "title": "QueryFamily",
  "type": "object",
  "required": [
    "family_id",
    "title",
    "description",
    "examples"
  ],
  "properties": {
    "family_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "examples": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "predicted_frequency": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "predicted_value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness_window_hours": { "type": "integer" },
    "allowed_memory_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["active", "suppressed", "expired"]
    }
  },
  "additionalProperties": false
}
