{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryExcellenceScorecard",
  "type": "object",
  "required": [
    "scorecard_id",
    "scores",
    "thresholds",
    "passed"
  ],
  "properties": {
    "scorecard_id": {
      "type": "string"
    },
    "scores": {
      "type": "object"
    },
    "thresholds": {
      "type": "object"
    },
    "passed": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
