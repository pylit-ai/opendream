{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceCatalog",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {"type": "integer"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workspace_path",
          "workspace_name",
          "first_seen_at",
          "last_seen_at",
          "discovered_by",
          "status_kind"
        ],
        "properties": {
          "workspace_path": {"type": "string"},
          "workspace_name": {"type": "string"},
          "repo_root_name": {"type": ["string", "null"]},
          "first_seen_at": {"type": "string"},
          "last_seen_at": {"type": "string"},
          "discovered_by": {
            "type": "string",
            "enum": ["init", "activate", "scan", "install-service", "manual-add", "status"]
          },
          "memory_dir": {"type": ["string", "null"]},
          "activation_state_summary": {"type": ["string", "null"]},
          "service_state_summary": {"type": ["string", "null"]},
          "semantic_state_summary": {"type": ["string", "null"]},
          "last_probe_at": {"type": ["string", "null"]},
          "status_kind": {
            "type": "string",
            "enum": ["ok", "stale", "missing", "broken"]
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
