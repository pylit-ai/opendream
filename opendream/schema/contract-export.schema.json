{
  "type": "object",
  "required": [
    "cli_output_version",
    "command_inventory",
    "contract_schema_version",
    "example_payloads",
    "opendream_version",
    "output_version_map",
    "schema_inventory",
    "supported_engine_ids",
    "supported_package_targets"
  ],
  "additionalProperties": false,
  "properties": {
    "cli_output_version": {
      "type": "integer",
      "description": "Same integer as command JSON payloads (e.g. status); string form duplicated in output_version_map.cli_json."
    },
    "contract_schema_version": { "type": "string" },
    "opendream_version": { "type": "string" },
    "command_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "schema_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "output_version_map": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "supported_engine_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supported_package_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "example_payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "payload_sha256", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "payload_sha256": { "type": "string" },
          "schema_name": { "type": "string" }
        }
      }
    },
    "semantic_adapter_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adapter_id", "execution_owner", "auth_source", "ingest_mode"],
        "properties": {
          "adapter_id": { "type": "string" },
          "execution_owner": { "type": "string" },
          "auth_source": { "type": "string" },
          "ingest_mode": { "type": "string" }
        }
      }
    },
    "semantic_auth_matrix": {
      "type": "object",
      "properties": {
        "strategies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unsupported": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "execution_ownership": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "execution_owners": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supported_strategies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unsupported_strategies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trust_boundaries": {
          "type": "object"
        }
      }
    },
    "semantic_read_model_contract": {
      "type": "object",
      "required": ["required_fields"],
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
