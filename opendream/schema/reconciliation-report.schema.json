{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReconciliationReport",
  "type": "object",
  "required": [
    "report_id",
    "workspace",
    "findings",
    "actions",
    "created_at"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "needs_review": {
      "type": "boolean"
    }
  }
}
