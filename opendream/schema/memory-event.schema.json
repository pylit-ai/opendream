{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-event.schema.json",
  "title": "MemoryEvent",
  "type": "object",
  "required": [
    "event_id",
    "session_id",
    "turn_id",
    "timestamp",
    "scope",
    "kind",
    "source",
    "content"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "session_id": { "type": "string" },
    "turn_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "string",
      "enum": ["user", "project", "agent", "workspace", "global"]
    },
    "kind": {
      "type": "string",
      "enum": [
        "remember_request",
        "user_correction",
        "project_decision",
        "environment_requirement",
        "debug_outcome",
        "workflow_step",
        "pending_item",
        "contradiction_signal",
        "preference_signal",
        "tool_failure",
        "task_outcome"
      ]
    },
    "source": {
      "type": "object",
      "required": ["channel", "message_ref"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["chat", "cli", "api", "slack", "telegram", "tool", "system"]
        },
        "message_ref": { "type": "string" },
        "file_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "content": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence_hint": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sensitivity": {
      "type": "string",
      "enum": ["normal", "secret", "sensitive", "do_not_store"]
    }
  },
  "additionalProperties": false
}
