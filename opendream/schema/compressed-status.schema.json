{
  "type": "object",
  "required": [
    "workspace",
    "overall_state",
    "targets",
    "runtime",
    "next_action",
    "product_posture",
    "semantic_capability_state",
    "semantic_unavailability_reason",
    "memory_quality",
    "context_pruning"
  ],
  "properties": {
    "workspace": {
      "type": "string"
    },
    "overall_state": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "broken",
        "inactive"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "runtime": {
      "type": "object"
    },
    "next_action": {
      "type": "string"
    },
    "product_posture": {
      "type": "string",
      "enum": [
        "semantic-first",
        "deterministic-by-choice"
      ]
    },
    "semantic_capability_state": {
      "type": "string",
      "enum": [
        "ready",
        "setup_required",
        "degraded",
        "disabled_by_choice"
      ]
    },
    "semantic_unavailability_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_quality": {
      "type": "object"
    },
    "context_pruning": {
      "type": "object"
    }
  }
}
