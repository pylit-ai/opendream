{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-dream-report.schema.json",
  "title": "SemanticDreamReport",
  "type": "object",
  "required": [
    "run_id",
    "mode",
    "status",
    "started_at",
    "phases"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": ["deterministic", "semantic", "hybrid"]
    },
    "status": {
      "type": "string",
      "enum": ["completed", "skipped", "failed", "partial"]
    },
    "reason": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "provider_id": { "type": "string" },
    "model_id": { "type": "string" },
    "phases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "query_families_considered": { "type": "integer" },
    "query_families_selected": { "type": "integer" },
    "proposals_generated": { "type": "integer" },
    "proposals_approved": { "type": "integer" },
    "proposals_rejected": { "type": "integer" },
    "learned_context_created": { "type": "integer" },
    "learned_context_superseded": { "type": "integer" },
    "tokens_used": { "type": "integer" },
    "cost_usd": { "type": "number" },
    "duration_ms": { "type": "integer" },
    "deterministic_summary": { "type": "object" },
    "semantic_summary": { "type": "object" },
    "verifier_summary": { "type": "object" },
    "harm_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trigger_class": { "type": "string" }
  },
  "additionalProperties": false
}
