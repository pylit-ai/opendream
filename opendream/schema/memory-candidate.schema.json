{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-candidate.schema.json",
  "title": "MemoryCandidate",
  "type": "object",
  "required": [
    "candidate_id",
    "derived_from_event_ids",
    "type",
    "scope",
    "title",
    "summary",
    "confidence",
    "salience",
    "status",
    "created_at",
    "origin_mode"
  ],
  "properties": {
    "candidate_id": { "type": "string" },
    "derived_from_event_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "type": {
      "type": "string",
      "enum": [
        "semantic_fact",
        "procedural_workflow",
        "user_preference",
        "project_decision",
        "environment_requirement",
        "anti_pattern",
        "pending_item",
        "contested_fact"
      ]
    },
    "scope": {
      "type": "string",
      "enum": ["user", "project", "agent", "workspace", "global"]
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "body": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "salience": { "type": "number", "minimum": 0, "maximum": 1 },
    "retrieval_boost": { "type": "number" },
    "status": {
      "type": "string",
      "enum": ["new", "merged", "rejected", "quarantined", "promoted"]
    },
    "origin_mode": {
      "type": "string",
      "enum": ["bootstrap", "scheduled"]
    },
    "memory_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflicts_with": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workflow_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
