{
  "id": "github-copilot",
  "version": "1",
  "title": "GitHub Copilot (repository instructions)",
  "activation_mode": "managed_prompt_snippet",
  "detection": {
    "detected": { "any_path_exists": [".github/copilot-instructions.md"] },
    "configured": { "any_path_exists": [".github/copilot-instructions.md"] }
  },
  "install_profile": "shell_hooks_markdown_block",
